# Estúdio Spy: preencha na aba Environment do EasyPanel (marque "Create .env file"). Nunca commite valores reais.
ADMIN_EMAILS=coven688@gmail.com
ANTHROPIC_API_KEY_PRODUTO=
WAVESPEED_API_KEY=
AGENTE_CPUS=2
AGENTE_MEMORIA=4g
MAX_PEDIDOS_SIMULTANEOS=1
PREVIA_USD=1
TETO_MIDIA_POR_VIDEO_USD=6
TETO_TOKENS_BASE_USD=8
TETO_TOKENS_POR_VIDEO_USD=4
# Venda (Cakto): pacotes em JSON numa linha; "oferta" = id da oferta (fim do link pay.cakto.com.br/<id>) ou short_id do produto
PACOTES_CAKTO=[{"oferta":"<id da oferta>","segundos":300,"nome":"Starter","preco":"R$ 297","link":"https://pay.cakto.com.br/<id>"}]
CAKTO_WEBHOOK_SECRET=
SUPORTE_URL=
URL_PUBLICA=
# Opcional: e-mail de "esqueci a senha" pela Resend (sem isso, o admin gera o link no painel)
RESEND_API_KEY=
EMAIL_REMETENTE=
RETENCAO_DIAS=30
# Banco e storage (Supabase do HookMill: schema "estudio" com usuário próprio + bucket privado "estudio-spy"). Sem isso, roda só no disco.
DATABASE_URL=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=estudio-spy
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
